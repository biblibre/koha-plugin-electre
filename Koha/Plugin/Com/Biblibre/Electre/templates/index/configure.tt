[% USE KohaDates %]
[%- TRY %]
    [%- PROCESS "Koha/Plugin/Com/Biblibre/Electre/i18n/${LANG}.inc" %]
[%- CATCH %]
    [% PROCESS "Koha/Plugin/Com/Biblibre/Electre/i18n/default.inc" %]
[%- END %]
[% INCLUDE 'doc-head-open.inc' %]
 <title>Koha: Electre Plugin: [% T.configuration | html %]</title>
[% INCLUDE 'doc-head-close.inc' %]
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const imageOnStaffCheckbox = document.getElementById('image_on_staff');
        const imageOnOpacCheckbox = document.getElementById('image_on_opac');
        const imageSizeGroupStaff = document.getElementById('image_size_group_staff');
        const imageSizeGroupOpac = document.getElementById('image_size_group_opac');

        function toggleImageSizeGroup() {
            if (imageOnStaffCheckbox.checked) {
                imageSizeGroupStaff.classList.remove('hide');
            } else {
                imageSizeGroupStaff.classList.add('hide');
            }
            
            if (imageOnOpacCheckbox.checked) {
                imageSizeGroupOpac.classList.remove('hide');
            } else {
                imageSizeGroupOpac.classList.add('hide');
            }
        }

        imageOnStaffCheckbox.addEventListener('change', toggleImageSizeGroup);
        imageOnOpacCheckbox.addEventListener('change', toggleImageSizeGroup);

        // Initial check
        toggleImageSizeGroup();
    });
</script>
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">[% T.home | html %]</a> &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">[% T.plugins_menu | html %]</a> &rsaquo; Electre &rsaquo; [% T.configuration | html %]</div>

<div class="container-fluid">
    <h3>Electre: [% T.configuration | html %]</h3>

    <form method="get" id="electre_plugin_config">
        <div class="container">
            <div class="row mb-3">
                <label for="access_username" class="col-sm-2">[% T.access_username | html %]</label>
                <div class="col-sm-2">
                    <input type="text" name="access_username" id="access_username" value="[% access_username | html %]" />
                </div>
            </div>
            <div class="row mb-3">
                <label for="access_password" class="col-sm-2">[% T.access_password | html %]</label>
                <div class="col-sm-2">
                    <input type="password" name="access_password" id="access_password" value="[% access_password | html %]" />
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2">[% T.show_resume | html %]</label>
                <div class="col-sm-6">
                    <div>
                        <input type="checkbox" id="resume_on_staff" name="resume_on_staff" value="1" [% IF resume_on_staff %] checked="checked" [% END %] />
                        <label for="resume_on_staff">[% T.staff | html %]</label>
                    </div>
                    <div>
                        <input type="checkbox" id="resume_on_opac" name="resume_on_opac" value="1" [% IF resume_on_opac %] checked="checked" [% END %] />
                        <label for="resume_on_opac">[% T.opac | html %]</label>
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2">[% T.show_image | html %]</label>
                <div class="col-sm-6">
                    <div>
                        <input type="checkbox" id="image_on_staff" name="image_on_staff" value="1" [% IF image_on_staff %] checked="checked" [% END %] />
                        <label for="image_on_staff">[% T.staff | html %]</label>
                        <div id="image_size_group_staff" class="mt-2 hide">
                            <label for="thumbnail_on_staff">[% T.thumbnail_size | html %]</label>
                            <select id="thumbnail_on_staff" name="thumbnail_on_staff">
                                <option value="1" [% IF thumbnail_on_staff == "1" %] selected="selected" [% END %]>[% T.yes | html %]</option>
                                <option value="0" [% IF thumbnail_on_staff == "0" %] selected="selected" [% END %]>[% T.no | html %]</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <input type="checkbox" id="image_on_opac" name="image_on_opac" value="1" [% IF image_on_opac %] checked="checked" [% END %] />
                        <label for="image_on_opac">[% T.opac | html %]</label>
                        <div id="image_size_group_opac" class="mt-2 hide">
                            <label for="thumbnail_on_opac">[% T.thumbnail_size | html %]</label>
                            <select id="thumbnail_on_opac" name="thumbnail_on_opac">
                                <option value="1" [% IF thumbnail_on_opac == "1" %] selected="selected" [% END %]>[% T.yes | html %]</option>
                                <option value="0" [% IF thumbnail_on_opac == "0" %] selected="selected" [% END %]>[% T.no | html %]</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <input type="hidden" name="class" value="[% CLASS %]"/>
            <input type="hidden" name="method" value="[% METHOD %]"/>
            <input type="hidden" name="save" value="1"/>
            <div class="row">
                <div class="col-sm-8">
                    <button type="submit" class="btn btn-primary w-100">[% T.save_button | html %]</button>
                </div>
            </div>
        </div>
    </form>
</div>

[% INCLUDE 'intranet-bottom.inc' %]